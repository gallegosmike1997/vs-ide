{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "vs-ide",
  "productName": "VS-IDE",
  "version": "0.1.4",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VS-IDE",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "publisher": "MZSG",
    "shortDescription": "AI-native code editor for Windows",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "certificateThumbprint": "05361CEC770AD275DBCD656E68F1A50A7288B09B",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNjBGMEQzREE3Q0Q1RDgKUldUWTFYemEwL0JndXprOFl3SVI1cGs2Z1lTVWpGVnpDbFh2NkkxTUM4THJUNlN3UUtMdzRwNmoK",
      "endpoints": [
        "https://github.com/gallegosmike1997/vs-ide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

