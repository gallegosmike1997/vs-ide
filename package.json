{
  "name": "vs-ide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "housekeeping": "node tools/run-clean.mjs",
    "housekeeping:quick": "node tools/run-clean.mjs --quick",
    "predev": "node tools/run-clean.mjs --quick",
    "dev": "vite",
    "prebuild": "node tools/run-clean.mjs --quick",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean:workspace": "python tools/vs_ide_clean.py",
    "clean:workspace:dry": "python tools/vs_ide_clean.py --dry-run",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build",
    "build:exe": "tauri build --bundles nsis",
    "test": "tsx test/normalizePlanResult.harness.ts && tsx test/commands.harness.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
