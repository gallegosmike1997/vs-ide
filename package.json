{
  "name": "vs-ide",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "housekeeping": "node tools/run-clean.mjs",
    "housekeeping:quick": "node tools/run-clean.mjs --quick",
    "predev": "node tools/run-clean.mjs --quick",
    "dev": "vite",
    "prebuild": "node tools/run-clean.mjs --quick",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean:workspace": "python tools/vs_ide_clean.py",
    "clean:workspace:dry": "python tools/vs_ide_clean.py --dry-run",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build",
    "build:exe": "tauri build",
    "release:manifest": "node tools/make-latest-json.mjs",
    "sign": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/sign-release.ps1",
    "unblock": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/unblock.ps1 -AllFiles",
    "package:portable": "pwsh -NoProfile -Command \"Copy-Item src-tauri\\target\\release\\vs_ide.exe dist\\VS-IDE-portable.exe -Force; Compress-Archive -Path dist\\VS-IDE-portable.exe -DestinationPath src-tauri\\target\\release\\bundle\\VS-IDE-portable.zip -Force; Remove-Item dist\\VS-IDE-portable.exe -Force; Write-Host 'portable zip ready (no installer, WebView2 not bundled)'\"",
    "test": "tsx test/normalizePlanResult.harness.ts && tsx test/commands.harness.ts && tsx test/scm.harness.ts && tsx test/fusion.harness.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
