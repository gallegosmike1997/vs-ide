# Copy to `.env.local` (git-ignored) and fill in what you need.
# All of these are optional — without a token the app uses the Puter sign-in popup,
# a local LM Studio / Ollama server, or a pasted provider key from Settings.

# Puter auth token (a JWT). Find it in the Puter desktop app / dashboard session
# (localStorage "puter.auth.token.v2" or the `puter.auth.token` cookie).
# With a token the IDE calls https://api.puter.com directly: no SDK, no popup.
VITE_PUTER_TOKEN=

# Model to preselect for the Puter free tier (default: gpt-5-nano).
VITE_PUTER_MODEL=gpt-5-nano